{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp",
        "--path",
        "${workspaceFolder}"
      ],
      "env": {
        "CODEGRAPH_DAEMON_IDLE_TIMEOUT_MS": "0",
        "CODEGRAPH_DAEMON_MAX_IDLE_MS": "0"
      }
    }
  }
}
