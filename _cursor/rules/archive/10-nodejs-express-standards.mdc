description: Node.js / Express backend standards — apply when express in package.json && !next (Deduped split)
globs:
  - "**/routes/**/*.{js,ts,mjs,cjs}"
  - "**/middleware/**/*.{js,ts,mjs,cjs}"
  - "**/controllers/**/*.{js,ts,mjs,cjs}"
  - "**/app.{js,ts,mjs,cjs}"
  - "**/server.{js,ts,mjs,cjs}"
